# Copy this to secrets.toml locally, or paste the contents into the host's
# Secrets box. NEVER commit secrets.toml itself — .gitignore excludes it.

# The AI tutor works with no key at all. Set these only if you want it to
# answer open-ended questions.
# QUBUILD_PROVIDER = "groq"
# QUBUILD_API_KEY  = "your-key-here"

# Free hosts wipe the disk on restart, which erases every account. Point this
# at a PostgreSQL database and accounts, cohorts and progress survive.
# QUBUILD_DB_URL = "postgresql://user:password@host:5432/qubuild"
